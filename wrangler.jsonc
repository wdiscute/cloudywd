{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudywd",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": [
      "/mods",
      "/mods/*"
    ],
    "not_found_handling": "404-page"
  }
}